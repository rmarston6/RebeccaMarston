<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Aspect Ratio Responsive Grid</title>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background: black;
      font-family: 'Digitany', sans-serif;
      overflow: hidden;
    }

    /* -------------- ASPECT RATIO CONTAINER ------------------- */
    .aspect-content-wrapper {
      position: fixed; /* always fits viewport, never scrolls offscreen */
      top: 0; left: 0;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: url('desk.PNG') center center no-repeat;
      background-size: cover;
      overflow: hidden;
    }

    /* This inner box maintains the aspect ratio. E.g. 16:9. */
    .aspect-ratio-box {
      position: relative;
      width: 90vw;
      height: calc(90vw * 0.5625); /* 16:9 aspect ratio (height = width * 9/16) */
      max-width: 100vw;
      max-height: 100vh;
      background: transparent;
      overflow: visible;
    }
    /* If viewport is too tall, limit by height */
    @media (max-aspect-ratio: 16/9) {
      .aspect-ratio-box {
        width: calc(90vh * 1.7778); /* width = height * 16/9 */
        height: 90vh;
      }
    }

    /* -------------- THE GRID ------------------- */
    .responsive-grid {
      display: grid;
      width: 100%;
      height: 100%;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(5, 1fr);
      position: absolute;
      top: 0; left: 0;
      gap: 2vw;
    }
    /* -------------- GRID ITEMS (EXAMPLES) ------------------- */
    .grid-item {
      position: relative;
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: all 0.2s;
    }
    /* Example positions using grid-area */
    .coffee-mug      { grid-column: 1; grid-row: 4; }
    .fiddle-leaf     { grid-column: 4; grid-row: 1; }
    .jade-plant      { grid-column: 1; grid-row: 3; }
    .planner         { grid-column: 2; grid-row: 2; }
    .red-book        { grid-column: 4; grid-row: 4; }
    .wisteria-bonsai { grid-column: 1; grid-row: 1; }
    /* Example: use percentage-based transforms for fine-tuning */
    .coffee-mug      { transform: translate(-10%, 40%); }
    .fiddle-leaf     { transform: translate(-30%, -10%); }
    .planner         { transform: translate(5%, -5%) rotate(8deg); }

    /* -------------- HERO & HEADER ------------------- */
    .hero-title {
      position: absolute;
      left: 50%;
      top: 10%;
      transform: translateX(-50%);
      font-size: 8vw;
      color: white;
      text-align: center;
      z-index: 10;
      pointer-events: none;
    }
    .scroll-bg {
      position: absolute;
      left: 50%;
      top: 20%;
      transform: translateX(-50%);
      width: 40vw;
      min-width: 250px;
      height: 8vw;
      background: url('scroll.png') center center no-repeat;
      background-size: contain;
      color: #322100;
      font-size: 1.5vw;
      display: flex;
      align-items: center;
      justify-content: center;
      text-shadow: 0 1px 8px #fffbe4, 0 0 2px #fffbe4;
      z-index: 11;
    }

    /* -------------- MAKE IT SCROLL IF NEEDED ------------------- */
    body, html {
      overflow: auto;
      min-height: 100vh;
    }
    .aspect-content-wrapper {
      overflow: auto;
    }

    /* -------------- RESPONSIVE TWEAKS ------------------- */
    @media (max-width: 700px) {
      .aspect-ratio-box { width: 98vw; }
      .hero-title { font-size: 12vw; }
      .scroll-bg { width: 90vw; font-size: 3vw; }
    }
  </style>
</head>
<body>
  <div class="aspect-content-wrapper">
    <div class="aspect-ratio-box">
      <div class="hero-title">Rebecca Marston</div>
      <div class="scroll-bg">
        Author of soft apocalypses, life-affirming grief, and wild gardens of tangled thought.
      </div>
      <div class="responsive-grid">
        <img src="coffee mug.PNG"        class="grid-item coffee-mug"      alt="Coffee Mug" />
        <img src="fiddleleaffig.PNG"     class="grid-item fiddle-leaf"    alt="Fiddle Leaf Fig" />
        <img src="jadeplant.PNG"         class="grid-item jade-plant"     alt="Jade Plant" />
        <img src="planner.PNG"           class="grid-item planner"        alt="Planner" />
        <img src="redbook.PNG"           class="grid-item red-book"       alt="Red Book" />
        <img src="wisteriabonsai.PNG"    class="grid-item wisteria-bonsai" alt="Wisteria Bonsai" />
      </div>
    </div>
  </div>
</body>
</html>
