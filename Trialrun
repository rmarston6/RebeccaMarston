<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Aspect Ratio Responsive Grid</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    html, body {
      width: 100vw;
      height: 100vh;
      margin: 0;
      padding: 0;
      background: black;
      font-family: 'Digitany', sans-serif;
      overflow: hidden;
    }

    /* --- Aspect Ratio Container --- */
    .aspect-content-wrapper {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: url('desk.PNG') center center no-repeat;
      background-size: cover;
      overflow: hidden;
    }

    /* Maintains a fixed aspect ratio (16:9 shown; adjust as needed) */
    .aspect-ratio-box {
      position: relative;
      width: 90vw;
      height: calc(90vw * 0.5625); /* 16:9 aspect ratio */
      max-width: 100vw;
      max-height: 100vh;
      background: transparent;
      overflow: hidden;
      box-shadow: 0 0 40px rgba(0,0,0,0.15);
    }
    /* If viewport is too tall, limit by height instead */
    @media (max-aspect-ratio: 16/9) {
      .aspect-ratio-box {
        width: calc(90vh * 1.7778); /* width = height * 16/9 */
        height: 90vh;
      }
    }

    /* --- Responsive Grid --- */
    .responsive-grid {
      display: grid;
      width: 100%;
      height: 100%;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(5, 1fr);
      gap: 2vw;
      position: absolute;
      top: 0; left: 0;
    }

    /* --- Grid Items: Use %/fr units! --- */
    .grid-item {
      width: 80%;    /* fills most of the cell, always scales */
      height: 80%;   /* keeps aspect ratio and fits within grid cell */
      object-fit: contain;
      justify-self: center;
      align-self: center;
      transition: all 0.2s;
      z-index: 2;
      /* Remove excessive transforms to keep inside the box! */
    }
    /* Example grid positions (adjust to taste) */
    .coffee-mug      { grid-column: 1; grid-row: 4; }
    .fiddle-leaf     { grid-column: 4; grid-row: 1; }
    .jade-plant      { grid-column: 1; grid-row: 3; }
    .planner         { grid-column: 2; grid-row: 2; }
    .red-book        { grid-column: 4; grid-row: 4; }
    .wisteria-bonsai { grid-column: 1; grid-row: 1; }
    /* You can use small transforms if you need to nudge, but keep them under ±25% */
    .coffee-mug      { transform: translate(-5%, 10%); }
    .fiddle-leaf     { transform: translate(-8%, -8%); }
    .planner         { transform: translate(5%, -5%) rotate(8deg); }

    /* --- HERO & HEADER --- */
    .hero-title {
      position: absolute;
      left: 50%;
      top: 8%;
      transform: translateX(-50%);
      font-size: 8vw;
      color: white;
      text-align: center;
      z-index: 10;
      pointer-events: none;
    }
    .scroll-bg {
      position: absolute;
      left: 50%;
      top: 20%;
      transform: translateX(-50%);
      width: 40vw;
      min-width: 250px;
      height: 8vw;
      background: url('scroll.png') center center no-repeat;
      background-size: contain;
      color: #322100;
      font-size: 1.5vw;
      display: flex;
      align-items: center;
      justify-content: center;
      text-shadow: 0 1px 8px #fffbe4, 0 0 2px #fffbe4;
      z-index: 11;
    }

    /* --- Responsive Tweaks --- */
    @media (max-width: 700px), (max-height: 700px) {
      .aspect-ratio-box { width: 98vw; }
      .hero-title { font-size: 12vw; }
      .scroll-bg { width: 90vw; font-size: 3vw; }
      .grid-item { width: 90%; height: 90%; }
    }
  </style>
</head>
<body>
  <div class="aspect-content-wrapper">
    <div class="aspect-ratio-box">
      <div class="hero-title">Rebecca Marston</div>
      <div class="scroll-bg">
        Author of soft apocalypses, life-affirming grief, and wild gardens of tangled thought.
      </div>
      <div class="responsive-grid">
        <img src="coffee mug.PNG"        class="grid-item coffee-mug"      alt="Coffee Mug" />
        <img src="fiddleleaffig.PNG"     class="grid-item fiddle-leaf"    alt="Fiddle Leaf Fig" />
        <img src="jadeplant.PNG"         class="grid-item jade-plant"     alt="Jade Plant" />
        <img src="planner.PNG"           class="grid-item planner"        alt="Planner" />
        <img src="redbook.PNG"           class="grid-item red-book"       alt="Red Book" />
        <img src="wisteriabonsai.PNG"    class="grid-item wisteria-bonsai" alt="Wisteria Bonsai" />
      </div>
    </div>
  </div>
</body>
</html>
